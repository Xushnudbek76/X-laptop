<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/home.css" />



<body class="home-body">
  <nav class="navbar">
    <div class="navbar-brand">
      <span class="brand-x">X</span>LAPTOP
    </div>
    <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <ul class="navbar-links" id="navbar-links">
      <li><a href="/admin" class="active">Home</a></li>
      <% if (!member) { %>
        <li><a href="/admin/signup">Signup</a></li>
        <li><a href="/admin/login">Login</a></li>
      <% } else { %>
        <li><a href="/admin/item/all">Laptops</a></li>
        <li><a href="/admin/user/all">Users</a></li>
        <li class="logout-link" onclick="return confirm('Logout?')"><a href="/admin/logout">Logout</a></li>
      <% } %>
    </ul>
  </nav>

  <section class="hero">
    <div class="hero-content">
      <div class="hero-label">Admin Dashboard</div>
      <h1 class="hero-title">
        <span class="x">X</span><span class="dash">-</span>LAPTOP
      </h1>
      <p class="hero-sub">Manage your laptop inventory, users, and orders from one place.</p>
      <div class="hero-actions">
        <% if (!member) { %>
          <a href="/admin/login" class="btn btn-primary"><i class="fa fa-sign-in-alt"></i> Login</a>
          <a href="/admin/signup" class="btn btn-ghost">Create Account</a>
        <% } else { %>
          <a href="/admin/item/all" class="btn btn-primary"><i class="fa fa-laptop"></i> Manage Laptops</a>
          <a href="/admin/user/all" class="btn btn-ghost">View Users</a>
        <% } %>
      </div>
      <div class="specs-strip">
        <div class="spec-item">
          <span class="spec-value">∞</span>
          <span class="spec-label">Products</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
          <span class="spec-value">24/7</span>
          <span class="spec-label">Uptime</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
          <span class="spec-value">100%</span>
          <span class="spec-label">Control</span>
        </div>
      </div>
    </div>
  </section>
</body>

<script>
  function toggleMenu() {
    document.getElementById('navbar-links').classList.toggle('open');
  }
</script>

<%- include('includes/footer') %>
