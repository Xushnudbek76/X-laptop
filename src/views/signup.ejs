<%- include('includes/header') %>

<style>
  .auth-body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: var(--bg);
    position: relative;
  }

  .auth-body::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(59,130,246,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59,130,246,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .auth-card {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    animation: slideUp 0.5s ease both;
  }

  .auth-card-top {
    background: linear-gradient(135deg, var(--bg-3), var(--bg-2));
    border-bottom: 1px solid var(--border);
    padding: 2rem 2rem 1.75rem;
  }

  .auth-logo { font-size: 1.5rem; font-weight: 800; letter-spacing: -1px; margin-bottom: 0.5rem; }
  .auth-logo span { color: var(--accent); }
  .auth-title { font-size: 1.5rem; font-weight: 800; color: var(--text); letter-spacing: -0.5px; }
  .auth-subtitle { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; font-family: var(--font-mono); }

  .auth-body-inner { padding: 2rem; display: flex; flex-direction: column; gap: 1.25rem; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .avatar-section {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem;
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .avatar-preview-wrap {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  .avatar-preview-wrap img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
  }

  .avatar-upload-btn {
    flex: 1;
  }

  .avatar-upload-btn label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
    transition: all var(--transition);
    text-transform: none;
    letter-spacing: 0;
  }

  .avatar-upload-btn label:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .avatar-upload-btn input[type="file"] { display: none; }

  .avatar-hint {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-top: 0.3rem;
    line-height: 1.5;
  }

  .auth-footer-text {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 1.25rem 2rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
  }

  .auth-footer-text a { color: var(--accent); font-weight: 600; }
  .auth-footer-text a:hover { color: var(--accent-hover); }

  .btn-full { width: 100%; padding: 0.75rem; font-size: 0.95rem; }

  .error-msg {
    font-size: 0.75rem;
    color: var(--danger);
    font-family: var(--font-mono);
    display: none;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<body class="auth-body">
  <div class="auth-card">
    <div class="auth-card-top">
      <div class="auth-logo"><span>X</span>-LAPTOP</div>
      <div class="auth-title">Create account</div>
      <div class="auth-subtitle">Set up your admin profile</div>
    </div>

    <form action="/admin/signup" method="POST" enctype="multipart/form-data" onsubmit="return validateSignupForm()">
      <div class="auth-body-inner">

        <div class="form-row">
          <div class="form-group">
            <label>Username</label>
            <input type="text" name="memberNick" class="member-nick" placeholder="admin123" required />
          </div>
          <div class="form-group">
            <label>Phone</label>
            <input type="text" name="memberPhone" class="member-phone" placeholder="+82 10 0000 0000" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Password</label>
            <input type="password" name="memberPassword" class="member-password" placeholder="••••••••" required />
          </div>
          <div class="form-group">
            <label>Confirm Password</label>
            <input type="password" name="confirmPassword" class="confirm-password" placeholder="••••••••" required />
          </div>
        </div>

        <span class="error-msg" id="pw-error">Passwords do not match.</span>

        <div class="avatar-section">
          <div class="avatar-preview-wrap">
            <img src="/img/default.jpeg" class="upload-img-frame" id="avatar-preview" alt="Avatar" />
          </div>
          <div class="avatar-upload-btn">
            <label for="member-image-input">
              <i class="fa fa-upload"></i> Upload Photo
            </label>
            <input type="file" id="member-image-input" name="memberImage" class="member-image" accept=".jpg,.jpeg,.png" />
            <p class="avatar-hint">JPG, JPEG or PNG only.<br/>Profile image for your account.</p>
          </div>
        </div>

        <input name="memberType" value="SHOP" hidden />

        <button type="submit" class="btn btn-primary btn-full">
          <i class="fa fa-user-plus"></i> Create Account
        </button>
      </div>
    </form>

    <div class="auth-footer-text">
      Already have an account? <a href="/admin/login">Sign in</a>
      &nbsp;·&nbsp;
      <a href="/admin">← Home</a>
    </div>
  </div>
</body>

<script src="/js/signup.js"></script>
<%- include('includes/footer') %>
