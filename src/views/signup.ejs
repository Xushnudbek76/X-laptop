<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/signup.css" />



<body class="auth-body">
  <div class="auth-card">
    <div class="auth-card-top">
      <div class="auth-logo"><span>X</span>-LAPTOP</div>
      <div class="auth-title">Create account</div>
      <div class="auth-subtitle">Set up your admin profile</div>
    </div>

    <form action="/admin/signup" method="POST" enctype="multipart/form-data" onsubmit="return validateSignupForm()">
      <div class="auth-body-inner">

        <div class="form-row">
          <div class="form-group">
            <label>Username</label>
            <input type="text" name="memberNick" class="member-nick" placeholder="admin123" required />
          </div>
          <div class="form-group">
            <label>Phone</label>
            <input type="text" name="memberPhone" class="member-phone" placeholder="+82 10 0000 0000" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Password</label>
            <input type="password" name="memberPassword" class="member-password" placeholder="••••••••" required />
          </div>
          <div class="form-group">
            <label>Confirm Password</label>
            <input type="password" name="confirmPassword" class="confirm-password" placeholder="••••••••" required />
          </div>
        </div>

        <span class="error-msg" id="pw-error">Passwords do not match.</span>

        <div class="avatar-section">
          <div class="avatar-preview-wrap">
            <img src="/img/default.jpeg" class="upload-img-frame" id="avatar-preview" alt="Avatar" />
          </div>
          <div class="avatar-upload-btn">
            <label for="member-image-input">
              <i class="fa fa-upload"></i> Upload Photo
            </label>
            <input type="file" id="member-image-input" name="memberImage" class="member-image" accept=".jpg,.jpeg,.png" />
            <p class="avatar-hint">JPG, JPEG or PNG only.<br/>Profile image for your account.</p>
          </div>
        </div>

        <input name="memberType" value="SHOP" hidden />

        <button type="submit" class="btn btn-primary btn-full">
          <i class="fa fa-user-plus"></i> Create Account
        </button>
      </div>
    </form>

    <div class="auth-footer-text">
      Already have an account? <a href="/admin/login">Sign in</a>
      &nbsp;·&nbsp;
      <a href="/admin">← Home</a>
    </div>
  </div>
</body>

<script src="/js/signup.js"></script>
<%- include('includes/footer') %>
