<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/login.css" />



<body class="auth-body">
  <div class="auth-card">
    <div class="auth-card-top">
      <div class="auth-logo"><span>X</span>-LAPTOP</div>
      <div class="auth-title">Welcome back</div>
      <div class="auth-subtitle">Sign in to your admin account</div>
    </div>

    <form action="/admin/login" method="POST">
      <div class="auth-body-inner">
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="memberNick" placeholder="Enter your username" required />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="memberPassword" placeholder="Enter your password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-full">
          <i class="fa fa-arrow-right-to-bracket"></i> Sign In
        </button>
      </div>
    </form>

    <div class="auth-footer-text">
      Don't have an account? <a href="/admin/signup">Sign up</a>
      &nbsp;·&nbsp;
      <a href="/admin">← Home</a>
    </div>
  </div>
</body>

<%- include('includes/footer') %>
