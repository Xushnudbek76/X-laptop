<%- include('includes/header') %>

<style>
  .page-body { min-height: 100vh; background: var(--bg); }

  .table-wrap { overflow-x: auto; }

  .member-nick-cell {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .member-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-3);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
    text-transform: uppercase;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
  }

  .empty-state i { font-size: 2.5rem; color: var(--border-light); margin-bottom: 1rem; }
  .empty-state h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .empty-state p { font-size: 0.85rem; color: var(--text-muted); font-family: var(--font-mono); }

  .users-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }
</style>

<body class="page-body">
  <nav class="navbar">
    <div class="navbar-brand"><span style="color:var(--accent)">X</span>LAPTOP</div>
    <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <ul class="navbar-links" id="navbar-links">
      <% if (!member) { %>
        <li><a href="/admin">Home</a></li>
        <li><a href="/admin/signup">Signup</a></li>
        <li><a href="/admin/login">Login</a></li>
      <% } else { %>
        <li><a href="/admin">Home</a></li>
        <li><a href="/admin/item/all">Laptops</a></li>
        <li><a href="/admin/user/all" class="active">Users</a></li>
        <li class="logout-link" onclick="return confirm('Logout?')"><a href="/admin/logout">Logout</a></li>
      <% } %>
    </ul>
  </nav>

  <div class="page-wrapper">
    <% if (!member) { %>
      <div class="empty-state">
        <i class="fa fa-lock"></i>
        <h3>Access Restricted</h3>
        <p>Please <a href="/admin/login" style="color:var(--accent)">login</a> to manage users.</p>
      </div>
    <% } else { %>
      <div class="panel">
        <div class="panel-header">
          <div style="display:flex; align-items:center; gap:0.75rem;">
            <span class="panel-title">All Users</span>
            <span class="users-count"><%= users.length %> total</span>
          </div>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>User</th>
                <th>Phone</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% users.map((e, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td>
                  <div class="member-nick-cell">
                    <div class="member-avatar"><%= e.memberNick.charAt(0) %></div>
                    <%= e.memberNick %>
                  </div>
                </td>
                <td><span style="font-family:var(--font-mono);font-size:0.82rem;"><%= e.memberPhone %></span></td>
                <td>
                  <select class="spec-select member-status" id="<%= e._id %>">
                    <option value="ACTIVE" <%= e.memberStatus === "ACTIVE" ? 'selected' : '' %>>ACTIVE</option>
                    <option value="BLOCK"  <%= e.memberStatus === "BLOCK"  ? 'selected' : '' %>>BLOCK</option>
                    <option value="DELETE" <%= e.memberStatus === "DELETE" ? 'selected' : '' %>>DELETE</option>
                  </select>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</body>

<script>
  function toggleMenu() {
    document.getElementById('navbar-links').classList.toggle('open');
  }
</script>
<script src="/js/users.js"></script>
<%- include('includes/footer') %>
